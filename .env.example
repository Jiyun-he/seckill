JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_DATACENTER_ID=0
SECKILL_CONSUMER_CONCURRENCY=2
DB_POOL_SIZE=20
