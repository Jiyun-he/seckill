# Copy this file to .env before starting Docker Compose.
# Replace every credential before using the project outside local development.

MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=seckill_db
MYSQL_USER=root
MYSQL_PASSWORD=123456

RABBITMQ_DEFAULT_USER=seckill
RABBITMQ_DEFAULT_PASS=seckill123
